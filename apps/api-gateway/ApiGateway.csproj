<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ApiGateway</RootNamespace>
    <AssemblyName>ApiGateway</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS8604: Possible null reference argument — atrapalha chamadas a ExecuteSqlRawAsync (params object[]).
         Os SQLs aceitam parâmetros nulos nativamente; tratar como warning resolveria, mas mantemos build estrito. -->
    <NoWarn>CA1014;CA2007;CS8604</NoWarn>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <UserSecretsId>agentes-api-gateway-2026</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core OpenAPI 3.1 nativo do .NET 10 -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <!-- Pin direto: transitivas antigas de Microsoft.OpenApi têm advisory NU1903
         (GHSA-v5pm-xwqc-g5wc) e o restore trata como erro. AspNetCore.OpenApi
         exige [2.12.2, 3.0.0) — 2.13.0 é a última 2.x. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />

    <!-- EF Core 10 + Postgres com JSONB nativo -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- snake_case: usuario_id, criado_em, etc. -->
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />

    <!-- Auth -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />

    <!-- Sentry — rastreio de erros do backend (LGPD: SendDefaultPii=false) -->
    <PackageReference Include="Sentry.AspNetCore" Version="6.12.1" />

    <!-- HTTP resilience (Polly + Microsoft.Extensions.Http.Resilience) -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />

    <!-- Password hashing: bcrypt (migração gradual de PBKDF2) -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />

    <!-- Pin direto: a transitiva System.Security.Cryptography.Pkcs 9.0.0 tem
         advisories NU1902/NU1903 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx)
         e o restore trata como erro — 10.0.14 é a corrigida. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
